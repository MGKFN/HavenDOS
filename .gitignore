# Build outputs. Everything here is regenerated by `make` from source, and
# a tracked copy is a copy that can go stale: the ISO and the kernel would
# then disagree about what they contain, which is the bug v0.7.20 shipped.
*.o
*.d
*.elf
*.iso
dist/
__pycache__/

# Generated by the two-pass build from havendos_pass1.elf. 9.7 MB, and a
# stale one embeds an old kernel into the installer without any warning.
include/kernel_elf.h

# Written by tools/make_version.py and tools/make_iso_manifest.py at build
# time. grub.cfg next to them IS source and stays tracked.
isodir/version.txt
isodir/update.inf
isodir/boot/havendos.elf

# Test fixtures, made by tools/make_*_fixture.py.
tests/*.img
tests/*.scratch*
tests/*.part
tests/*.fsck
